[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/CampfireUI.gd" id="1_ui"]
[ext_resource type="Theme" path="res://assets/ui/battle/battle_theme.tres" id="2_theme"]

[node name="CampfireUI" type="CanvasLayer"]
script = ExtResource("1_ui")

[node name="UISFX" type="AudioStreamPlayer" parent="."]
bus = &"UI"

[node name="Overlay" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Mask" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.02, 0.03, 0.84)

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Panel" type="PanelContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(560, 650)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Overlay/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Title" type="Label" parent="Overlay/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.902, 0.753, 0.29, 1)
theme_override_font_sizes/font_size = 34
text = "篝火"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Overlay/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.43, 0.4, 1)
theme_override_font_sizes/font_size = 17
text = "火星仍未熄灭。"
horizontal_alignment = 1

[node name="RestButton" type="Button" parent="Overlay/Center/Panel/Content"]
custom_minimum_size = Vector2(420, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "休息"

[node name="UpgradeButton" type="Button" parent="Overlay/Center/Panel/Content"]
custom_minimum_size = Vector2(420, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "升级"

[node name="SkillButton" type="Button" parent="Overlay/Center/Panel/Content"]
custom_minimum_size = Vector2(420, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "技能点"

[node name="TravelButton" type="Button" parent="Overlay/Center/Panel/Content"]
custom_minimum_size = Vector2(420, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "传送"

[node name="LeaveButton" type="Button" parent="Overlay/Center/Panel/Content"]
custom_minimum_size = Vector2(420, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "离开"

[node name="Status" type="Label" parent="Overlay/Center/Panel/Content"]
custom_minimum_size = Vector2(440, 58)
layout_mode = 2
theme_override_colors/font_color = Color(0.847, 0.812, 0.753, 1)
theme_override_font_sizes/font_size = 17
text = "恢复全队 HP / MP，并清除异常状态。"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Hint" type="Label" parent="Overlay/Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.43, 0.4, 1)
theme_override_font_sizes/font_size = 15
text = "[W/S] 选择　[Z] 确认　[X] 离开"
horizontal_alignment = 1
