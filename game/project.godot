; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="游戏开发"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

Log="*res://scripts/autoload/Log.gd"
GameData="*res://scripts/autoload/GameData.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
GameCamera="*res://scripts/autoload/GameCamera.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"
DialogueManager="*res://scripts/autoload/DialogueManager.gd"

[dialogic]

directories/dch_directory={
"forest_wanderer": "res://dialogue/characters/forest_wanderer.dch"
}
directories/dtl_directory={
"forest_wanderer": "res://dialogue/timelines/forest_wanderer.dtl"
}
layout/default_style="res://dialogue/styles/project_dialogue_style.tres"
layout/style_directory={
"": "res://dialogue/styles/project_dialogue_style.tres",
"Project Dialogue": "res://dialogue/styles/project_dialogue_style.tres"
}
layout/style_list=Array[String](["res://dialogue/styles/project_dialogue_style.tres"])
text/input_action="dialogic_default_action"
variables={
"story": {
"branches": {
"forest_wanderer": "unseen"
},
"flags": {
"met_forest_wanderer": false
}
}
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_resource_groups/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

