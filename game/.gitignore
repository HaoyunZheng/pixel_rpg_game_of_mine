# Godot 4 专用
.godot/
/.godot/

# 导出产物
/build/
/export/
export_presets.cfg

# 视觉自愈循环的截图证物(throwaway,不进库;保留 .gdignore 让 Godot 别导入)
/screenshots/*
!/screenshots/.gdignore

# 本地密钥配置(真实 key 不进库;保留示例和 .gdignore)
/secrets/*
!/secrets/.gdignore
!/secrets/meowa.cfg.example

# 系统/编辑器
.DS_Store
*.tmp
*~

# 注意:不要忽略 assets/、scenes/、scripts/、*.tres、*.import —— 这些要进版本库。
